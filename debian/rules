#!/usr/bin/make -f
# -*- makefile -*-

# Uncomment this to turn on verbose mode.
#export DH_VERBOSE=1

%:
	dh $@
	
override_dh_auto_configure:
	dh_auto_configure -- -D_FIRESTARTER_VERSION_STRING="2.2" -D_FIRESTARTER_BUILD_YEAR="2026" -DCMAKE_POLICY_VERSION_MINIMUM=3.5

override_dh_auto_install:
	mkdir -p debian/tmp/usr/bin
	cp obj-x86_64-linux-gnu/src/FIRESTARTER debian/tmp/usr/bin
